{
  "name": "research-notebook",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first structured research notebook.",
  "homepage": "https://github.com/research-notebook/research-notebook",
  "author": "Research Notebook Maintainers <maintainers@researchnotebook.app>",
  "desktopName": "research-notebook",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify:sidecars": "node scripts/verify-whisper-sidecars.mjs",
    "benchmark:scenarios": "node scripts/perf-scenarios.mjs",
    "package:linux": "npm run build && npm run verify:sidecars && electron-builder --config electron-builder.yml --linux AppImage deb rpm --x64 --publish never",
    "package:win": "npm run build && npm run verify:sidecars && electron-builder --config electron-builder.yml --win nsis portable --x64 --publish never",
    "test": "vitest run",
    "pretest": "npm rebuild better-sqlite3",
    "posttest": "electron-rebuild -f -w better-sqlite3",
    "test:main": "vitest run --project main",
    "pretest:main": "npm rebuild better-sqlite3",
    "posttest:main": "electron-rebuild -f -w better-sqlite3",
    "test:renderer": "vitest run --project renderer --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "npm rebuild better-sqlite3",
    "posttest:coverage": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-sqlite3": "^13.0.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.51.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.14.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^4.0.6",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.12",
    "vitest": "^4.0.6"
  }
}
